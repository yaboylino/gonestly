package app

import (
	"log/slog"

	"github.com/yaboylino/gonestly"
	"github.com/yaboylino/gonestly/config"
)

type LogConfig struct {
	Level string `env:"LOG_LEVEL" default:"info"`
	Format string `env:"LOG_FORMAT" default:"auto"`
}

func NewLogger() (*slog.Logger, error) {
	cfg, err := config.Load[LogConfig](config.Options{})
	if err != nil {
		return nil, err
	}
	return gonestly.NewLogger(gonestly.LogOptions{Level: cfg.Level, Format: cfg.Format})
}
