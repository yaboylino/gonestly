package app

import (
	"fmt"

	"github.com/yaboylino/gonestly"
)

// Config is read from environment variables and the .env file.
type Config struct {
	Port int `default:"3000"`
{{- if .Database}}
	DatabaseURL string `env:"DATABASE_URL,required"`
{{- end}}
	// Docs serves the OpenAPI document and Swagger UI; set DOCS=false to hide them.
	Docs bool `default:"true"`
}

// NewServerConfig listens on the configured port.
func NewServerConfig(cfg Config) gonestly.ServerConfig {
	return gonestly.ServerConfig{Addr: fmt.Sprintf(":%d", cfg.Port)}
}

// NewOpenAPIConfig describes the API in its documentation.
func NewOpenAPIConfig(cfg Config) gonestly.OpenAPIConfig {
	return gonestly.OpenAPIConfig{Title: "{{.Title}}", Version: "0.1.0", Disabled: !cfg.Docs}
}
