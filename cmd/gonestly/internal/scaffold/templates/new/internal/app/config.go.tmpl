package app

import (
	"fmt"
	"log/slog"

	"github.com/yaboylino/gonestly"
)

type Config struct {
	Port int `default:"3000"`
{{- if .Database}}
	DatabaseURL string `env:"DATABASE_URL,required"`
{{- end}}
	CORSOrigins []string `env:"CORS_ORIGINS"`
	TrustedProxies int `env:"TRUSTED_PROXIES"`
	Docs bool `default:"true"`
}

func NewServerConfig(cfg Config, logger *slog.Logger) gonestly.ServerConfig {
	return gonestly.ServerConfig{
		Addr:       fmt.Sprintf(":%d", cfg.Port),
		Middleware: []gonestly.Middleware{
			gonestly.RequestID(),
			gonestly.AccessLog(logger),
			gonestly.TrustProxies(cfg.TrustedProxies),
			gonestly.SecurityHeaders(gonestly.SecurityHeadersConfig{TrustForwardedProto: cfg.TrustedProxies > 0}),
		},
		CORS:       gonestly.CORSConfig{AllowedOrigins: cfg.CORSOrigins},
	}
}

func NewOpenAPIConfig(cfg Config) gonestly.OpenAPIConfig {
	return gonestly.OpenAPIConfig{Title: "{{.Title}}", Version: "0.1.0", Disabled: !cfg.Docs}
}
