PORT=3000
{{- if eq .Database "postgres"}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/{{.Names.Snake}}?sslmode=disable
{{- else if eq .Database "mysql"}}
DATABASE_URL=root:root@tcp(localhost:3306)/{{.Names.Snake}}
{{- else if eq .Database "sqlite"}}
DATABASE_URL=file:{{.Names.Snake}}.db?_pragma=foreign_keys(1)&_pragma=busy_timeout(5000)
{{- end}}
# The origins of the frontends that may call the API, separated by commas.
# CORS_ORIGINS=http://localhost:4200
# The number of reverse proxies in front of the application, for the client address.
# TRUSTED_PROXIES=1
DOCS=true
# The level (debug, info, warn or error) and format (text, json, or auto: text in a terminal and
# JSON elsewhere) of the logs.
# LOG_LEVEL=info
# LOG_FORMAT=auto
