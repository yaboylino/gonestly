package {{.Names.Package}}

import (
	"context"
	"time"

	"github.com/yaboylino/gonestly/sql"
)

const defaultLimit = 20

type Service struct {
	repo *sql.Repository[{{.Names.Model}}, int64]
}

func NewService(repo *sql.Repository[{{.Names.Model}}, int64]) *Service {
	return &Service{repo: repo}
}

func (s *Service) List(ctx context.Context, page, limit int) (ListResponse, error) {
	page = max(page, 1)
	if limit < 1 {
		limit = defaultLimit
	}
	query := s.repo.Query()
	items, err := query.OrderBy({{.Names.Model}}Columns.ID.Asc()).Limit(limit).Offset((page - 1) * limit).All(ctx)
	if err != nil {
		return ListResponse{}, err
	}
	total, err := query.Count(ctx)
	if err != nil {
		return ListResponse{}, err
	}
	if items == nil {
		items = []{{.Names.Model}}{}
	}
	return ListResponse{Items: items, Total: total}, nil
}

func (s *Service) Find(ctx context.Context, id int64) ({{.Names.Model}}, error) {
	return s.repo.FindByID(ctx, id)
}

func (s *Service) Create(ctx context.Context, req CreateRequest) ({{.Names.Model}}, error) {
	item := {{.Names.Model}}{Name: req.Name}
	err := s.repo.Create(ctx, &item)
	return item, err
}

func (s *Service) Update(ctx context.Context, req UpdateRequest) ({{.Names.Model}}, error) {
	item, err := s.repo.FindByID(ctx, req.ID)
	if err != nil {
		return {{.Names.Model}}{}, err
	}
	item.Name = req.Name
	item.UpdatedAt = time.Now().UTC()
	err = s.repo.Update(ctx, &item)
	return item, err
}

func (s *Service) Delete(ctx context.Context, id int64) error {
	return s.repo.Delete(ctx, id)
}
