package {{.Names.Package}}

import (
	"context"

	"github.com/yaboylino/gonestly"
)

type Controller struct {
	service *Service
}

func NewController(service *Service) *Controller {
	return &Controller{service: service}
}

func (c *Controller) Routes(r *gonestly.Router) {
	r.Prefix("/{{.Names.Kebab}}")
	gonestly.Get(r, "/", c.List, gonestly.Summary("List {{.Names.Words}}"))
	gonestly.Get(r, "/{id}", c.Find, gonestly.Summary("Find a {{.Names.ModelWords}}"))
	gonestly.Post(r, "/", c.Create, gonestly.Summary("Create a {{.Names.ModelWords}}"))
	gonestly.Put(r, "/{id}", c.Update, gonestly.Summary("Update a {{.Names.ModelWords}}"))
	gonestly.Delete(r, "/{id}", c.Delete, gonestly.Summary("Delete a {{.Names.ModelWords}}"))
}

func (c *Controller) List(ctx context.Context, req ListRequest) (ListResponse, error) {
	return c.service.List(ctx, req.Page, req.Limit)
}

func (c *Controller) Find(ctx context.Context, req FindRequest) ({{.Names.Model}}, error) {
	return c.service.Find(ctx, req.ID)
}

func (c *Controller) Create(ctx context.Context, req CreateRequest) ({{.Names.Model}}, error) {
	return c.service.Create(ctx, req)
}

func (c *Controller) Update(ctx context.Context, req UpdateRequest) ({{.Names.Model}}, error) {
	return c.service.Update(ctx, req)
}

func (c *Controller) Delete(ctx context.Context, req FindRequest) (gonestly.Empty, error) {
	return gonestly.Empty{}, c.service.Delete(ctx, req.ID)
}
